# .env.example
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Connection string for MongoDB. Defaults to local MongoDB if not provided.
# Example for local: mongodb://127.0.0.1:27017/academic_records
# Example for Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/academic_db
MONGODB_URI="mongodb://127.0.0.1:27017/academic_records"

# JWT_SECRET: Secret key for signing tokens
JWT_SECRET="your_jwt_secret_key"
